# Lab guests on 192.168.2.0/24, the same on every machine. Linked to ~/.ssh/config.d/lab
# by agents-config/install.sh; ~/.ssh/config must start with `Include ~/.ssh/config.d/*`.
# Key: ~/.ssh/lab, one per machine, authorized on every guest and registered in Dokku.
# On the Macs, lab-tunnel (linked beside this file) adds the Cloudflare tunnel fallback.
# Lab documentation: homelab repo, README.md (Access) and config/jump/README.md.

Host pve
  HostName 192.168.2.10
  User root

Host cloudflared
  HostName 192.168.2.14
  User root

Host workbench
  HostName 192.168.2.15
  User ubuntu

Host media
  HostName 192.168.2.16
  User ubuntu

Host infra
  HostName 192.168.2.17
  User ubuntu

Host dokku
  HostName 192.168.2.13
  User dokku

Host dokku-admin
  HostName 192.168.2.13
  User ubuntu

Host cliproxy
  HostName 192.168.2.18
  User root

Host jump
  HostName 192.168.2.22
  User jump
  HostKeyAlias jump

Host jump-admin
  HostName 192.168.2.22
  User root
  HostKeyAlias jump

Host pve cloudflared workbench media infra dokku dokku-admin cliproxy jump jump-admin
  IdentityFile ~/.ssh/lab
  IdentitiesOnly yes
