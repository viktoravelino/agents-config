{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": ["/Users/viktoravelino/notes"],
    "deny": ["Bash(gh pr merge*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/viktoravelino/projects/agents-config/shared/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/viktoravelino/projects/agents-config/shared/hooks/langflow-lint-stop.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mcp@agents-config": true
  },
  "extraKnownMarketplaces": {
    "agents-config": {
      "source": {
        "source": "directory",
        "path": "/Users/viktoravelino/projects/agents-config"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "model": "opus"
}
