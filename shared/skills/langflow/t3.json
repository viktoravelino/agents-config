{
  "$schema": "https://t3.codes/schema/t3.json",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup worktree",
      "command": "for f in .env src/frontend/.env; do [ -f \"$T3CODE_PROJECT_ROOT/$f\" ] && [ ! -e \"$f\" ] && cp \"$T3CODE_PROJECT_ROOT/$f\" \"$f\"; done; true",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Stack up (Docker)",
      "command": "\"$HOME/.claude/skills/langflow/bin/lf-stack\" --t3 up && \"$HOME/.claude/skills/langflow/bin/lf-stack\" --t3 logs -f",
      "icon": "play"
    },
    {
      "name": "Stack down (Docker)",
      "command": "\"$HOME/.claude/skills/langflow/bin/lf-stack\" --t3 down -v",
      "icon": "configure",
      "runOnSettle": true
    }
  ]
}
