#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v bun >/dev/null 2>&1; then
  echo "install: bun is required (brew install oven-sh/bun/bun)" >&2
  exit 1
fi

if [ ! -d "$DIR/node_modules" ]; then
  (cd "$DIR" && bun install --frozen-lockfile)
fi

exec bun "$DIR/installer/main.ts" "$@"
